# ---------------------------------------------------------------------------
# JK BMS → OpenSearch stack — configuration template.
# Copy to .env and edit:   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED: Bluetooth MAC address of your JK BMS.
# Find it with:  bluetoothctl scan on   (or the JK BMS phone app / any BLE scanner)
# Leave the placeholder out — the collector refuses to start without it.
JK_BMS_MAC=AA:BB:CC:DD:EE:FF

# Friendly name shown in the web UI tabs/titles.
DEVICE_NAME=My JK BMS

# Daily index name = INDEX_PREFIX-YYYY.MM.DD, date computed in INDEX_TZ.
# Pick YOUR timezone so each day's index matches your local midnight.
INDEX_PREFIX=jkbms
INDEX_TZ=Europe/Madrid

# Timezone shown on the history charts (IANA name).
CHARTS_TZ=Europe/Madrid

# Host ports (containers always talk on the internal network).
OS_PORT=9200
BACKEND_PORT=8099
WEB_PORT=8098
