# addons/gridguard/.env.example  (thresholds from CALIBRATION.md are copied in)
# TZ drives ALL windows and timers — set to YOUR timezone (example: Europe/Madrid).
TZ=Europe/Madrid
WINDOW_START=09:00
WINDOW_END=22:00
EVE_START=20:00
FINAL_OFFSET_MIN=5
THRESH_DEEP=2.90
AH_ON=5
AH_OFF=10
SOLAR_OFF_A=10
SOLAR_HOLD_S=300
SOLAR_NOISE_A=2.0
SAFETY_FACTOR=1.2
HIST_DAYS=7
BMS_CELL_FIELDS=v1,v2,v3,v4,v5,v6,v7,v8
BMS_CURRENT_PATH=pack.current
BMS_REMAINING_AH_PATH=soc.remaining_ah
OPENSEARCH_URL=http://127.0.0.1:9205
BMS_INDEX=bms-2p4s-upstairs-*
EWCLOUD_EMAIL=
EWCLOUD_PASS=
EWCLOUD_CC=+34
SW_MAIN_DEVICEID=
SW_MAIN_DEVICEKEY=
SW_MAIN_IP=
NTFY_WEBHOOK=
MSG_LANG=en
WEATHER_LAT=
WEATHER_LON=
WEATHER_MIN_J=
WEATHER_INDEX=1
WEATHER_INDEX_PREFIX=gridguard-weather
# reserve tiers (weather-driven discharge floor, see README)
TIER1_DAYS=2
TIER2_WMO_CODE=95
TIER2_GUST_KMH=75
TIER2_INTENSITY_MMH=25
TIER_LOOKAHEAD_DAYS=3
TIER_RELEASE_HYST_PCT=2
# reference-load model + solar-day/physics
REF_NIGHTS=5
REF_MIN_CLIP_MIN=30
FLOW_A=3.0
FORECAST_REFRESH_MIN=30
TRUE_FLOOR_V=3.15
R_CELL_OHM=0.005
POLL_FAST_S=300
POLL_MORNING_S=600
PROBE_NIGHT_S=1800
LOG_DIR=/data
DRY_RUN=1
EVENTS_INDEX_PREFIX=gridguard-events
EVENTS_INDEX=1
